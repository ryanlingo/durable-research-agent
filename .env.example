# Copy to .env and fill in values:
#   cp .env.example .env

# Required for live LLM and embedding calls
OPENAI_API_KEY=

# Models (shared by both agent implementations)
LLM_MODEL=gpt-5.6-luna
# "small" → text-embedding-3-small; also: large | text-embedding-3-large
EMBEDDING_MODEL=small

# Optional: real web search (otherwise deterministic mock results)
# TAVILY_API_KEY=
